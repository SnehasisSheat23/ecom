{
  "name": "dubai-ecom-backend-v2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --import tsx src/server.ts",
    "db:setup": "node --import tsx --env-file=.env src/database/create-tables.ts",
    "seed": "node --import tsx --env-file=.env src/database/seed.ts",
    "test": "node --env-file=.env ./node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "@hono/node-server": "^1.19.17",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.8.3",
    "pg": "^8.21.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
