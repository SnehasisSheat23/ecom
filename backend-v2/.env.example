# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:6543/postgres"
PORT=8787
API_BASE_URL="http://localhost:8787"

# S3 Storage Configuration
S3_BUCKET=standcore
S3_REGION=eu-west-1
S3_ENDPOINT=https://your-supabase-ref.storage.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_PUBLIC_BASE_URL=https://your-supabase-ref.supabase.co/storage/v1/object/public/standcore

# Auth Configuration
BETTER_AUTH_URL="http://localhost:8787"
BETTER_AUTH_SECRET="your-auth-secret"
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Resend Email Service
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="Abdullah Bakheet <orders@abdullahbakheetksa.com>"

# NalPay Saudi Payment Gateway
NALPAY_SECRET_KEY="sk_test_or_live_key"
NALPAY_API_URL="https://nalpay.io/v1"
NALPAY_WEBHOOK_SECRET=""
